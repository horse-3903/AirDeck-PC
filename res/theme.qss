* {
	font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", sans-serif;
	font-size: 10pt;
	color: #E2E8F0;
}

QMainWindow, QStackedWidget, QWidget#MainMenu, QWidget#Server, QWidget#About, QWidget#Preferences {
	background-color: #000000;
}

QMenuBar {
	background: #000000;
	max-height: 0px;
}

QStatusBar {
	background: #000000;
	color: #A3A3A3;
}

QToolTip {
	background-color: #111111;
	color: #E2E8F0;
	border: 1px solid #333333;
	border-radius: 4px;
	padding: 6px 8px;
}

QLabel {
	background: transparent;
}

QLabel[role="title"] {
	font-size: 26pt;
	font-weight: 700;
	color: #FFFFFF;
}

QLabel[role="subtitle"] {
	font-size: 11pt;
	color: #A3A3A3;
}

QLabel[role="heading"] {
	font-size: 13pt;
	font-weight: 600;
	color: #FFFFFF;
}

QLabel[role="caption"] {
	font-size: 9pt;
	color: #A3A3A3;
}

QLabel[role="pill"] {
	background: transparent;
	border: none;
	padding: 4px 0;
	color: #A3A3A3;
}

QFrame[role="card"] {
	background-color: #111111;
	border: 1px solid #262626;
	border-radius: 4px;
}

QFrame[role="card"] QLabel {
	background: transparent;
}

QPushButton {
	background-color: #1A1A1A;
	color: #E2E8F0;
	border: 1px solid #333333;
	border-radius: 4px;
	padding: 10px 20px;
	min-height: 22px;
	font-weight: 500;
}

QPushButton:hover {
	background-color: #262626;
	border-color: #707070;
}

QPushButton:pressed {
	background-color: #111111;
}

QPushButton:focus {
	border: 2px solid #D4D4D4;
}

QPushButton:disabled {
	background-color: #121212;
	color: #6B6B6B;
	border-color: #1E1E1E;
}

QPushButton[variant="primary"] {
	background-color: #F5F5F5;
	border: 1px solid #FFFFFF;
	color: #000000;
	font-size: 12pt;
	font-weight: 600;
	padding: 14px 24px;
}

QPushButton[variant="primary"]:hover {
	background-color: #FFFFFF;
}

QPushButton[variant="primary"]:pressed {
	background-color: #C4C4C4;
}

QPushButton[variant="danger"] {
	background-color: rgba(244, 63, 94, 0.14);
	border: 1px solid #F43F5E;
	color: #FDA4AF;
}

QPushButton[variant="danger"]:hover {
	background-color: #F43F5E;
	color: #FFFFFF;
}

QPushButton[variant="ghost"] {
	background-color: transparent;
	border: 1px solid transparent;
	color: #A3A3A3;
}

QPushButton[variant="ghost"]:hover {
	background-color: #111111;
	color: #FFFFFF;
}

QGroupBox {
	background-color: #111111;
	border: 1px solid #262626;
	border-radius: 4px;
	margin-top: 22px;
	padding: 18px 14px 12px 14px;
	font-weight: 600;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 0px;
	padding: 0;
	color: #D4D4D4;
}

QLineEdit, QSpinBox, QComboBox {
	background-color: #0A0A0A;
	border: 1px solid #333333;
	border-radius: 4px;
	padding: 6px 10px;
	min-height: 22px;
	selection-background-color: #3A3A3A;
	selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
	border-color: #707070;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
	border: 2px solid #D4D4D4;
	padding: 5px 9px;
}

QComboBox::drop-down {
	border: none;
	width: 26px;
}

QComboBox QAbstractItemView {
	background-color: #111111;
	border: 1px solid #333333;
	border-radius: 4px;
	selection-background-color: #3A3A3A;
	outline: none;
	padding: 4px;
}

QSpinBox::up-button, QSpinBox::down-button {
	width: 18px;
	border: none;
	background: transparent;
}

QSlider::groove:horizontal {
	height: 6px;
	background: #333333;
	border-radius: 3px;
}

QSlider::sub-page:horizontal {
	background: #D4D4D4;
	border-radius: 3px;
}

QSlider::handle:horizontal {
	background: #FFFFFF;
	border: 2px solid #D4D4D4;
	width: 16px;
	height: 16px;
	margin: -7px 0;
	border-radius: 10px;
}

QSlider::handle:horizontal:hover {
	background: #E5E5E5;
}

QRadioButton, QCheckBox {
	spacing: 10px;
	padding: 4px 0;
	background: transparent;
}

QRadioButton::indicator, QCheckBox::indicator {
	width: 16px;
	height: 16px;
	border: 2px solid #707070;
	background: #0A0A0A;
}

QRadioButton::indicator {
	border-radius: 10px;
}

QCheckBox::indicator {
	border-radius: 4px;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
	border-color: #D4D4D4;
}

QRadioButton::indicator:checked {
	background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #D4D4D4, stop:0.45 #D4D4D4, stop:0.55 #0A0A0A, stop:1 #0A0A0A);
	border-color: #D4D4D4;
}

QCheckBox::indicator:checked {
	background: #F5F5F5;
	border-color: #D4D4D4;
}

QSpinBox {
	max-width: 140px;
}

QTabWidget::pane {
	border: none;
	background: transparent;
	margin: 0px;
	padding: 0px;
	top: 0px;
	left: 0px;
}

QTabBar {
	background: transparent;
}

QTabBar::tab {
	background: transparent;
	color: #A3A3A3;
	padding: 10px 18px;
	margin: 2px 6px 2px 0;
	border-radius: 4px;
	min-width: 70px;
}

QTabBar::tab:hover {
	background-color: #151515;
	color: #FFFFFF;
}

QTabBar::tab:selected {
	background-color: #262626;
	color: #FFFFFF;
	font-weight: 600;
}

QListWidget {
	background-color: transparent;
	border: none;
	outline: none;
}

QListWidget::item {
	padding: 12px 14px;
	margin: 3px 0;
	border-radius: 4px;
	color: #E2E8F0;
	font-size: 12pt;
}

QListWidget::item:hover {
	background-color: #1A1A1A;
}

QListWidget::item:selected {
	background-color: #2E2E2E;
	color: #FFFFFF;
	border: 1px solid #555555;
}

QTextBrowser {
	background-color: #111111;
	border: 1px solid #262626;
	border-radius: 4px;
	padding: 12px;
	selection-background-color: #3A3A3A;
}

QScrollArea, QScrollArea > QWidget > QWidget {
	background: transparent;
	border: none;
}

QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	background: #333333;
	border-radius: 4px;
	min-height: 30px;
}

QScrollBar::handle:vertical:hover {
	background: #707070;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
	height: 0;
	width: 0;
}

QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 2px;
}

QScrollBar::handle:horizontal {
	background: #333333;
	border-radius: 4px;
	min-width: 30px;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
	color: #262626;
}

QMessageBox, QDialog {
	background-color: #000000;
}

QGroupBox#profilesGroup {
	background: transparent;
	border: none;
	padding: 12px 0 0 0;
	margin-top: 14px;
}

QGroupBox#profilesGroup::title {
	left: 0;
	padding: 0;
}

QFrame#triggerSeparator, QFrame#thumbstickSeparator {
	background-color: #2A2A2A;
	border: none;
	min-height: 1px;
	max-height: 1px;
	margin: 8px 0;
}

QListWidget#prefsSidebar::item {
	padding: 10px 14px;
	margin: 2px 0;
	font-size: 10pt;
	border-radius: 4px;
	border: none;
}

QListWidget#prefsSidebar::item:selected {
	background-color: #262626;
	border: none;
	font-weight: 600;
}

QLabel#Pointer, QLabel#label_port {
	min-width: 120px;
}

QPushButton[variant="danger"] {
	min-height: 18px;
}

QListWidget#IPList::item {
	font-size: 11pt;
}

QDialog, QInputDialog {
	background-color: #000000;
}

QTextBrowser#descriptionBox {
	background: transparent;
	border: none;
}

QDialogButtonBox QPushButton {
	min-width: 110px;
}

QLabel#Pointer, QLabel#label_port {
	min-width: 120px;
}

QDialog QPushButton[variant="primary"] {
	font-size: 10pt;
	font-weight: 600;
	padding: 8px 20px;
}

QGroupBox#executorGroup {
	padding: 8px 18px 14px 18px;
}

QGroupBox#executorGroup QRadioButton, QGroupBox#executorGroup QLabel {
	font-weight: 400;
}

QLabel#executorNotesLabel {
	color: #A3A3A3;
	padding: 2px 0 0 0;
}

QPushButton {
	outline: none;
}
